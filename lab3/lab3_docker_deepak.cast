[5386.718721, "o", "\u001b[1;1H\u001b[34m# import Jinja2 library and PyYAML\u001b[m\r\n\u001b[35mfrom\u001b[m jinja2 \u001b[35mimport\u001b[m Environment, FileSystemLoader\r\n\u001b[35mimport\u001b[m yaml\r\n\r\n\u001b[34m# Declare template environment\u001b[m\r\nENV = Environment(loader=FileSystemLoader(\u001b[31m'.'\u001b[m))\r\n\u001b[38;5;130mdef\u001b[m \u001b[36mget_interface_speed\u001b[m(interface_name):\r\n    \u001b[31m\"\"\" get_interface_speed returns the default Mbps value for a given\r\n    network interface by looking for certain keywords in the name\r\n    \"\"\"\u001b[m\r\n    \u001b[38;5;130mif\u001b[m \u001b[31m'gigabit'\u001b[m \u001b[38;5;130min\u001b[m interface_name.lower():\u001b[12;9H\u001b[38;5;130mreturn\u001b[m \u001b[31m1000\u001b[m\r\n    \u001b[38;5;130mif\u001b[m \u001b[31m'fast'\u001b[m \u001b[38;5;130min\u001b[m interface_name.lower():\u001b[14;9H\u001b[38;5;130mreturn\u001b[m \u001b[31m100\u001b[m\r\n\u001b[34m# Filters are added to the ENV object after declaration. Note that we're\r\n# actually passing in our \"get_interface_speed\" function and not running\r\n# it--the template engine will execute this function when we call\r\n# template.render()\u001b[m\r\nENV.filters[\u001b[31m'get_interface_speed'\u001b[m] = get_interface_speed\r\ntemplate = ENV.get_t"]
[5386.719162, "o", "emplate(\u001b[31m\"template-task8.j2\"\u001b[m)\r\n\u001b[34m# We load our YAML file and pass it in to the template when rendering it.\u001b[m\r\n\u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m\"data-task7.yml\"\u001b[m) \u001b[38;5;130mas\u001b[m f:\r\n    interfaces = yaml.load(f, Loader=yaml.SafeLoader)\r\n    \u001b[36mprint\u001b[m(template.render(interface_list=interfaces))\r\n\u001b[94m~                                                                                                     \u001b[26;1H~                                                                                                     \u001b[27;1H~                                                                                                     \u001b[28;1H~                                                                                                     \u001b[29;1H~                                                                                                     \u001b[30;1H~                                                                                                     "]
