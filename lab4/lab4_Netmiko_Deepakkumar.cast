[5689.073476, "o", "ccessfully\"\u001b[m)\r\n net_connect.disconnect()\r\n\u001b[36mprint\u001b[m(\u001b[31m\"Done!\"\u001b[m)\r\n\u001b[94m~                                                                                                     \u001b[22;1H~                                                                                                     \u001b[23;1H~                                                                                                     \u001b[24;1H~                                                                                                     \u001b[25;1H~                                                                                                     \u001b[26;1H~                                                                                                     \u001b[27;1H~                                                                                                     \u001b[28;1H~                                                                                                     "]
