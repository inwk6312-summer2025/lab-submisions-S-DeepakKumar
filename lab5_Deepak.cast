[255.299567, "o", "        +--rw type?                identityref\r\n        +--rw enabled?             boolean"]
[255.299946, "o", "\r\n        +--rw router-id?           yang:dotted-quad {router-id}?\r\n        +--rw description?         string"]
[255.300313, "o", "\r\n        +--rw interfaces\r\n        |  +--rw interface*   if:interface-ref"]
[255.300647, "o", "\r\n        +--rw routing-protocols"]
[255.300977, "o", "\r\n        |  +--rw routing-protocol* [type name]"]
[255.301353, "o", "\r\n        |     +--rw type             identityref\r\n        |     +--rw name             string"]
[255.302644, "o", "\r\n        |     +--rw description?     string"]
[255.303011, "o", "\r\n        |     +--rw static-routes\r\n        +--rw ribs"]
[255.303344, "o", "\r\n           +--rw rib* [name]"]
[255.303869, "o", "\r\n              +--rw name              string"]
[255.304114, "o", "\r\n"]
[255.304401, "o", "              +--rw address-family?   identityref"]
[255.304749, "o", "\r\n              +--rw description?      string"]
[255.305164, "o", "\r\n\r\n  augment /if:interfaces-state/if:interface:"]
[255.305489, "o", "\r\n    +--ro routing-instance?   string"]
[255.305928, "o", "\r\n\r\n  rpcs:\r\n    +---x fib-route\r\n       +---w input"]
[255.307146, "o", "\r\n       |  +---w routing-instance-name    string\r\n       |  +---w destination-address"]
[255.307464, "o", "\r\n       |     +---w address-family    identityref"]
[255.307842, "o", "\r\n       +--ro output\r\n          +--ro route"]
[255.308154, "o", "\r\n             +--ro address-family     identityref"]
[255.308513, "o", "\r\n             +--ro next-hop\r\n"]
[255.308927, "o", "             |  +--ro (next-hop-options)\r\n             |     +--:(simple-next-hop)"]
[255.309244, "o", "\r\n             |     |  +--ro outgoing-interface?   string"]
[255.309614, "o", "\r\n             |     |  +--ro next-hop-address?     string"]
[255.309979, "o", "\r\n             |     +--:(special-next-hop)\r\n             |        +--ro special-next-hop?     enumeration"]
[255.311088, "o", "\r\n             +--ro source-protocol    identityref"]
[255.311481, "o", "\r\n             +--ro active?            empty\r\n             +--ro last-updated?      yang:date-and-time"]
[255.314451, "o", "\r\n"]
